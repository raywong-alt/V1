public/audio/

# 系統雜項
.DS_Store
Thumbs.db

# 編輯器
.vscode/*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Claude Code 工作區設定（本地開發工具，不納入版本控制）
.claude/
