# ── 前端設定（Vite 可見，非敏感）────────────────────────────────────
# 前端 API 基礎 URL，指向後端服務
# 後端負責處理 AI 分析呼叫，不要把 AI key 放前端
VITE_API_BASE_URL=http://localhost:3000

# ── 音訊生成腳本設定（scripts/ 專用，絕不加 VITE_ 前綴）──────────
# Azure Speech 服務訂閱 key
# 申請：https://aka.ms/azurespeech
AZURE_SPEECH_KEY=your_azure_speech_key_here

# Azure Speech 服務區域（建議使用 eastasia 或 japaneast 降低延遲）
AZURE_SPEECH_REGION=eastasia
